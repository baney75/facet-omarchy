{
  "manifest_version": 3,
  "name": "Facet for Omarchy",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Facet sidebar"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "webNavigation",
    "scripting",
    "history",
    "bookmarks",
    "downloads",
    "sessions",
    "alarms",
    "notifications",
    "nativeMessaging",
    "tts",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Toggle sidebar"
    }
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page/core.js",
        "page/dark.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page/extract.js",
        "page/links.js",
        "page/reader.js",
        "page/highlights.js",
        "page/calm.js",
        "page/video.js",
        "page/sponsor.js",
        "page/peek.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
