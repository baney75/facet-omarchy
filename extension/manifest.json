{
  "manifest_version": 3,
  "name": "Facet for Omarchy",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Facet sidebar"
  },
  "side_panel": {
    "default_path": "shell/tabs.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "webNavigation",
    "scripting",
    "history",
    "bookmarks",
    "downloads",
    "sessions",
    "alarms",
    "notifications",
    "nativeMessaging",
    "tts",
    "tabCapture",
    "offscreen",
    "search",
    "topSites",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Toggle sidebar"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+K"
      },
      "description": "Open command palette"
    },
    "next-space": {
      "suggested_key": {
        "default": "Alt+PageDown"
      },
      "description": "Next Space"
    },
    "prev-space": {
      "suggested_key": {
        "default": "Alt+PageUp"
      },
      "description": "Previous Space"
    },
    "tidy-tabs": {
      "description": "Tidy tabs by domain"
    },
    "new-space": {
      "description": "New Space"
    },
    "toggle-pin": {
      "description": "Pin or unpin tab"
    },
    "dev-palette": {
      "description": "Developer palette"
    }
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page/core.js",
        "page/dark.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page/extract.js",
        "page/links.js",
        "page/reader.js",
        "page/highlights.js",
        "page/calm.js",
        "page/video.js",
        "page/sponsor.js",
        "page/peek.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "shell/newtab.html"
  }
}
